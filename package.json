{
  "name": "nameforge",
  "version": "1.1.0",
  "private": true,
  "description": "Générateur de modèles 3D paramétriques pour MakerWorld",
  "main": "main.js",
  "author": "NameForge",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_IS_DEV=1 electron .\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "download-openscad": "node scripts/download-openscad.js",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "electron-updater": "6.8.3",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.0.1",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "i18next": "^26.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.13",
    "wait-on": "^8.0.1"
  }
}
